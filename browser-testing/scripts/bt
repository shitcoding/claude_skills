#!/usr/bin/env bash
# bt — single entry point for the browser-testing skill.
#
# Bootstraps the venv on first use, then dispatches:
#   bt --start|--stop|--status|--login [URL]   → setup_chrome.sh (Chrome lifecycle)
#   bt --python ...                            → venv python (for multi-step flows)
#   bt <URL> [flags]                           → browse.py (inspection CLI)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "$SCRIPT_DIR")"
VENV="$SKILL_DIR/.venv"

command -v python3 >/dev/null 2>&1 || { echo "browser-testing: python3 is required." >&2; exit 1; }

# ── Per-project isolation ────────────────────────────────────────────────
# Profile dir and CDP port derive from the project root (git top-level, else cwd),
# so sessions in different projects run separate Chromes with separate cookies
# and never attach to each other's browser. Chrome refuses to start twice on one
# profile and silently attaches on a shared port, so BOTH must differ.
# Explicit BT_CHROME_PROFILE / CDP_PORT still win. Derived once, exported, so
# setup_chrome.sh, browse.py and --python snippets all see the same values.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)"     # symlinked paths hash the same
HASH="$(ROOT="$PROJECT_ROOT" python3 -c \
    'import hashlib, os; print(hashlib.sha1(os.environ["ROOT"].encode()).hexdigest()[:6])')"
export BT_PROJECT_ROOT="$PROJECT_ROOT"
export BT_CHROME_PROFILE="${BT_CHROME_PROFILE:-$HOME/.claude/browser-testing-profiles/$(basename "$PROJECT_ROOT")-$HASH}"
# 9340–9399: excludes the legacy shared 9333 and the usual 9222, so an old-style
# Chrome left running can't be attached to by accident. A 1-in-60 collision between
# two projects is caught loudly by setup_chrome.sh's ownership guard.
export CDP_PORT="${CDP_PORT:-$((9340 + 0x$HASH % 60))}"

if [[ "${1:-}" == "--reinstall" ]]; then
    echo "browser-testing: removing $VENV ..." >&2
    rm -rf "$VENV"
    shift            # must not reach browse.py — it would reject the flag
    REINSTALL_ONLY=1
fi

# ── Bootstrap ────────────────────────────────────────────────────────────
# Runs before the lifecycle commands too: --stop needs the venv's Playwright to
# close Chrome gracefully (a bare SIGTERM earns a macOS crash dialog).
#
# Probe the CORE imports only, not just the interpreter: a venv left half-installed
# by an interrupted pip would otherwise be reused forever and fail with ImportError.
# Optional extras (axe) are deliberately NOT probed — a bad release of one must not
# be able to block the whole skill from bootstrapping. `bt --reinstall` adds them.
venv_ok() { "$VENV/bin/python" -c "import playwright, PIL" >/dev/null 2>&1; }

if ! venv_ok; then
    # connect.py uses `X | None` annotations, evaluated at def time.
    if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
        echo "browser-testing: needs Python 3.10+, found $(python3 -V 2>&1)." >&2
        exit 1
    fi
    # Two sessions (or two parallel calls) must not pip-install into one venv at
    # once. ponytail: mkdir lock, treated as stale after 10 min — no flock on macOS.
    LOCK="$VENV.lock"
    for _ in $(seq 1 600); do
        mkdir "$LOCK" 2>/dev/null && break
        [[ -n "$(find "$LOCK" -maxdepth 0 -mmin +10 2>/dev/null)" ]] && rmdir "$LOCK" 2>/dev/null
        sleep 1
    done
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    if ! venv_ok; then     # re-probe: the other bootstrapper may have finished meanwhile
        echo "browser-testing: setting up venv at $VENV ..." >&2
        python3 -m venv "$VENV"
        "$VENV/bin/python" -m pip install -q --upgrade pip
        "$VENV/bin/python" -m pip install -q -r "$SKILL_DIR/requirements.txt"
        echo "browser-testing: venv ready." >&2
    fi
    rmdir "$LOCK" 2>/dev/null || true
    trap - EXIT
fi

# `bt --reinstall` on its own is a maintenance command, not a page request. With
# trailing args, re-dispatch them from the top (the venv is rebuilt, so no loop).
if [[ -n "${REINSTALL_ONLY:-}" ]]; then
    [[ $# -eq 0 ]] && exit 0
    exec "$0" "$@"
fi

# ── Dispatch ─────────────────────────────────────────────────────────────

case "${1:-}" in
    --start) shift; exec bash "$SCRIPT_DIR/setup_chrome.sh" "$@" ;;
    --stop|--status|--login)
             exec bash "$SCRIPT_DIR/setup_chrome.sh" "$@" ;;
esac

# Let `--python` snippets `import connect` without a sys.path dance.
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
    --python) shift; exec "$VENV/bin/python" "$@" ;;
    *)        exec "$VENV/bin/python" "$SCRIPT_DIR/browse.py" "$@" ;;
esac
